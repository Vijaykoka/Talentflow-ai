generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TA_TEAM")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(uuid())
  name      String   @unique
  industry  String?
  contact   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demands   Demand[]
  hires     Hire[]
}

model Vendor {
  id              String   @id @default(uuid())
  name            String
  contact         String?
  email           String?
  commissionRate  Float    @default(0.1)
  performanceScore Float   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  demands    Demand[]
  hires      Hire[]
  candidates Candidate[]
}

model Demand {
  id            String   @id @default(uuid())
  title         String
  jdText        String?
  requiredSkills String
  rateMin       Float
  rateMax       Float
  location      String?
  priority      String   @default("MEDIUM")
  status        String   @default("OPEN")
  clientId      String?
  vendorId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client?          @relation(fields: [clientId], references: [id])
  vendor        Vendor?          @relation(fields: [vendorId], references: [id])
  matches       JobCandidateMatch[]
  hires         Hire[]

  @@index([status])
  @@index([priority])
}

model Candidate {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  resumeUrl       String?
  extractedSkills String
  experienceYears Float    @default(0)
  currentCtc      Float?
  expectedCtc     Float?
  status          String   @default("AVAILABLE")
  hotTalent       Boolean  @default(false)
  location        String?
  vendorId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor        Vendor?          @relation(fields: [vendorId], references: [id])
  resumes       Resume[]
  matches       JobCandidateMatch[]
  hires         Hire[]

  @@index([status])
  @@index([hotTalent])
}

model Resume {
  id             String   @id @default(uuid())
  candidateId    String
  originalFile   String
  parsedText     String?
  extractedSkills String
  education      String?
  experience     String?
  createdAt      DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model JobCandidateMatch {
  id           String   @id @default(uuid())
  demandId     String
  candidateId  String
  matchScore   Float
  matchReason  String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  demand    Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  feedback  InterviewFeedback?
  interviews Interview[]

  @@unique([demandId, candidateId])
  @@index([demandId])
  @@index([candidateId])
  @@index([matchScore])
}

model InterviewFeedback {
  id              String   @id @default(uuid())
  matchId         String   @unique
  rating          Int      // 1 to 5 stars
  interviewer     String   // Name of interviewer
  technicalScore  Int      // 0 to 100
  behavioralScore Int      // 0 to 100
  comments        String
  recommendation  String   // "STRONG_HIRE" | "HIRE" | "NO_HIRE" | "STRONG_NO_HIRE"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  match           JobCandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Hire {
  id               String   @id @default(uuid())
  demandId         String
  candidateId      String
  clientId         String?
  vendorId         String?
  hiredRate        Float
  hiringCost       Float    @default(0)
  startDate        DateTime
  projectedMargin12m Float?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  demand    Demand    @relation(fields: [demandId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([demandId])
  @@index([candidateId])
}

model Interview {
  id              String   @id @default(uuid())
  matchId         String
  scheduledAt     DateTime
  panelName       String   // e.g. "Deepak S., John D."
  panelEmails     String?  // comma-separated emails
  meetingLink     String?
  status          String   @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match           JobCandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}